{
	"name": "api",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "SkillIssue web API: Auth0 sign-in, Tiger Data (TimescaleDB) accounts, matches, stats and leaderboards. Also serves the website.",
	"scripts": {
