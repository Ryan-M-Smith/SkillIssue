	},
	"dependencies": {
		"jose": "^6.2.13",
		"pg": "^8.23.1",
		"tsx": "^4.23.15"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@types/pg": "^8.15.6",
		"typescript": "^7.0.2"
	}
}
