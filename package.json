{
	"name": "SkillIssue",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"workspaces": [
		"apps/companion",
		"apps/landing",
		"apps/server",
		"packages/*"
	],
	"scripts": {
		"test": "npm run test:companion && npm run test:network",
		"test:companion": "tsx --tsconfig apps/companion/tsconfig.json --test apps/companion/tests/*.test.mts",
		"test:network": "node --test apps/server/network.integration.test.ts",
		"test:game": "node scripts/test-game.mjs",
		"typecheck": "tsc --noEmit -p apps/companion/tsconfig.json && tsc --noEmit -p apps/server/tsconfig.json",
		"lint": "npm --prefix apps/companion run lint -- --max-warnings 0",
		"landing:dev": "pnpm --filter landing dev",
		"landing:build": "pnpm --filter landing build",
		"landing:lint": "pnpm --filter landing lint",
		"companion:lan": "npm --prefix apps/companion run start -- --lan",
		"companion:start": "npm --prefix apps/companion run start -- --tunnel",
		"server:start": "npm --prefix apps/server run start"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@12.15.0",
	"type": "module"
}
